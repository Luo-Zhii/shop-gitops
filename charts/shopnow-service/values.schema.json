{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "shopnow-service values",
  "type": "object",
  "required": ["name", "port", "image", "global", "rollout", "autoscaling", "resources"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$"},
    "component": {"type": "string", "enum": ["backend", "frontend", "aiops"]},
    "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
    "replicaCount": {"type": "integer", "minimum": 0},
    "global": {
      "type": "object",
      "required": ["env", "provider", "domain"],
      "properties": {
        "env": {"type": "string", "enum": ["dev", "staging", "prod-onprem", "prod-aws", "ci"]},
        "provider": {"type": "string", "enum": ["onprem", "aws"]},
        "domain": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "required": ["registry"],
      "properties": {
        "registry": {"type": "string", "minLength": 1},
        "repository": {"type": "string"},
        "tag": {"type": "string", "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tag": {"type": "string", "not": {"const": "latest"}},
          "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"}
        }
      }
    },
    "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["memory"]}
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "privileged": {"const": false},
        "allowPrivilegeEscalation": {"const": false},
        "readOnlyRootFilesystem": {"const": true}
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {"runAsNonRoot": {"const": true}}
    },
    "rollout": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "trafficRouting": {"type": "string", "enum": ["none", "nginx", "alb"]},
        "steps": {"type": "array", "minItems": 1},
        "analysis": {
          "type": "object",
          "properties": {
            "maxErrorRate": {"type": "number", "minimum": 0, "maximum": 1},
            "maxP95Seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "required": ["enabled", "type"],
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"type": "string", "enum": ["hpa", "keda"]},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "keda": {
          "type": "object",
          "properties": {
            "rpsPerPod": {"type": "number", "minimum": 0},
            "kafkaLag": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["topic", "consumerGroup"],
                "properties": {
                  "topic": {"type": "string"},
                  "consumerGroup": {"type": "string"},
                  "lagThreshold": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "hostPrefix": {"type": "string"},
        "className": {"type": "string"}
      }
    },
    "externalSecret": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "keys": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "sharedKeys": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}}
      }
    }
  }
}
